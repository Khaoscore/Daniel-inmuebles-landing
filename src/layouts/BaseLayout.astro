---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Daniel Inmuebles — acompañamiento profesional para comprar y vender inmuebles en Bogotá.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-CO" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Fija el modo antes del primer pintado para evitar el parpadeo:
      1) la elección guardada con el botón día/noche,
      2) si no hay, la preferencia del sistema operativo.
      La clave debe coincidir con THEME_STORAGE_KEY en ThemeToggle.tsx.
    -->
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('di-theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#021024" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Daniel Inmuebles" />

    <!-- Tipografías del diseño: Bricolage Grotesque (display), Manrope (UI), Roboto (texto) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,700;12..96,75..100,800&family=Manrope:wght@400;500;600;700;800&family=Roboto:wght@400;500&display=swap"
    />
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-(--radius-button) focus:bg-brand-yellow focus:px-5 focus:py-3 focus:font-bold focus:text-navy-900"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
  </body>
</html>
