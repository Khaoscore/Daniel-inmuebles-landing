---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PropertySearch from '../../components/react/PropertySearch.tsx';
import { getProperties } from '../../lib/catalog';
import type { Property } from '../../data/properties';
import { WHATSAPP_URL } from '../../data/site';

/**
 * Catálogo completo: sólo los filtros y todas las propiedades, sin paginar.
 * La búsqueda por texto libre vive en la home.
 */

// Se consulta Supabase en cada visita: lo que se agrega o elimina en la base
// de datos se ve aquí en la siguiente recarga.
let properties: Property[] = [];
let failed = false;
try {
  properties = await getProperties();
} catch (error) {
  console.error(error);
  failed = true;
}
---

<BaseLayout
  title="Propiedades en Bogotá — Daniel Inmuebles"
  description="Todos nuestros apartamentos y casas en Bogotá. Filtra por zona, habitaciones, baños, precio y tipo de inmueble."
>
  <section class="section-x py-[70px]">
    <div class="container-site">
      <h1 class="sr-only">Propiedades</h1>
      {
        failed ? (
          <div class="rounded-(--radius-field) bg-card p-10 text-center text-fg">
            <p class="text-[19px] font-semibold">
              No pudimos cargar las propiedades en este momento.
            </p>
            <p class="mt-2 text-[16px] leading-5">
              Recarga la página en unos segundos o{' '}
              <a href={WHATSAPP_URL} class="underline" target="_blank" rel="noopener noreferrer">
                escríbenos por WhatsApp
              </a>
              .
            </p>
          </div>
        ) : (
          <PropertySearch
            client:load
            properties={properties}
            textSearch={false}
            paginate={false}
          />
        )
      }
    </div>
  </section>
</BaseLayout>
