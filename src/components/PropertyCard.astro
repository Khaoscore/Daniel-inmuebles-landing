---
import { formatPriceShort, formatPropertyMeta, type Property } from '../data/properties';

/**
 * Tarjeta compacta de propiedad (carrusel del mapa y catálogo).
 * Figma: nodos 163:4779 (claro) y 152:3112 (oscuro).
 */
interface Props {
  property: Property;
  /** Ancho fijo de 264px para el carrusel; fluido en las rejillas. */
  fixedWidth?: boolean;
  class?: string;
}

const { property, fixedWidth = false, class: className = '' } = Astro.props;
const href = `/propiedades/${property.slug}`;
---

<article
  class:list={[
    'flex flex-col gap-2 rounded-(--radius-field) bg-card p-[14px] text-fg',
    fixedWidth && 'w-[264px] shrink-0',
    className,
  ]}
>
  <a href={href} class="block h-[177px] overflow-hidden rounded-[11px]">
    <img
      src={property.image}
      alt={`${property.title} en ${property.neighborhood}`}
      width="236"
      height="177"
      loading="lazy"
      decoding="async"
      class="size-full object-cover transition-transform duration-300 hover:scale-105"
    />
  </a>

  <div class="flex flex-col gap-2">
    <div class="flex items-baseline justify-between gap-2 font-semibold">
      <h3 class="text-[16px] leading-5">
        <a href={href} class="transition-opacity hover:opacity-70">{property.title}</a>
      </h3>
      <span class="text-[12px] whitespace-nowrap">{property.type}</span>
    </div>

    <p class="text-[14px] leading-[22px]">{formatPropertyMeta(property)}</p>

    <p
      class="font-display text-[34px] leading-[34px] font-extrabold tracking-[-0.68px] text-accent"
    >
      {formatPriceShort(property.price)}
    </p>

    <a
      href={href}
      class="flex h-[41px] items-center justify-center rounded-[9px] bg-cta px-4 text-[14px] font-bold text-navy-900 transition-opacity hover:opacity-90"
    >
      Agendar visita
    </a>
  </div>
</article>
