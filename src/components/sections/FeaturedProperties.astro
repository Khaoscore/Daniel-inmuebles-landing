---
import FeaturedPropertyCard from '../FeaturedPropertyCard.astro';
import Button from '../ui/Button.astro';
import type { Property } from '../../data/properties';

/** Figma: nodos 163:4275 (claro) y 149:968 (oscuro). */
interface Props {
  properties: Property[];
}

const { properties } = Astro.props;
---

{
  properties.length > 0 && (
    <section id="destacadas" class="section-x section-y">
      <div class="container-site flex flex-col gap-11">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="font-display text-[32px] leading-[1.05] font-extrabold tracking-[-0.02em] text-heading md:text-[48px] md:leading-[46px]">
            Propiedades destacadas
          </h2>

          <Button href="/propiedades" variant="soft" size="lg" icon="east">
            Ver todas las propiedades
          </Button>
        </div>

        <div class="flex flex-col gap-6 md:flex-row md:justify-center">
          {properties.map((property) => (
            <FeaturedPropertyCard property={property} />
          ))}
        </div>
      </div>
    </section>
  )
}
