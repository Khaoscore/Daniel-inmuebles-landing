---
import Button from '../ui/Button.astro';
import { CONTACT } from '../../data/site';

/** Figma: nodos 163:4698 (claro) y 149:1391 (oscuro). */
---

<section class="section-x bg-band pt-[110px] pb-[140px]">
  <div class="container-site flex flex-col items-start justify-between gap-12 lg:flex-row lg:items-end">
    <div class="flex flex-1 flex-col gap-[17px]">
      <p class="text-[28px] leading-9 font-semibold tracking-[-0.72px] text-brand-yellow md:text-[36px]">
        Valoración gratuita
      </p>

      <h2
        class="font-display text-[40px] leading-[1.05] font-extrabold tracking-[-0.02em] text-white md:text-[60px] md:leading-[55px]"
      >
        ¿Quieres saber cuánto vale realmente tu inmueble?
      </h2>

      <p class="max-w-[540px] text-[16px] leading-5 text-white">
        Solicita una valoración comercial gratuita y recibe una estimación basada en el
        comportamiento actual del mercado.
      </p>
    </div>

    <div class="flex flex-col items-start gap-[14px]">
      <a
        href={CONTACT.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[16px] leading-5 font-semibold text-brand-yellow transition-opacity hover:opacity-80"
      >
        WhatsApp · {CONTACT.phoneDisplay}
      </a>

      <a
        href={CONTACT.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[16px] leading-5 font-semibold text-brand-yellow transition-opacity hover:opacity-80"
      >
        Instagram · {CONTACT.instagram}
      </a>

      <a
        href={`mailto:${CONTACT.email}`}
        class="text-[16px] leading-5 font-semibold text-brand-yellow transition-opacity hover:opacity-80"
      >
        {CONTACT.email}
      </a>

      <Button
        href={CONTACT.whatsappUrl}
        variant="cta"
        icon="east"
        external
        class="w-full"
      >
        Valoración gratuita
      </Button>
    </div>
  </div>
</section>
