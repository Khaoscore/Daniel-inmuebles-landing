---
import { formatPriceShort, formatPropertyMeta, type Property } from '../data/properties';

/**
 * Tarjeta grande del bloque "Propiedades destacadas".
 * Figma: nodos 163:4284 (claro) y 149:977 (oscuro).
 */
interface Props {
  property: Property;
}

const { property } = Astro.props;
const href = `/propiedades/${property.slug}`;
const meta = formatPropertyMeta({ ...property, neighborhood: null });
---

<article class="flex h-[449px] flex-1 flex-col overflow-hidden rounded-(--radius-panel) bg-card">
  <a href={href} class="min-h-0 flex-1 overflow-hidden bg-fg/5">
    <img
      src={`${property.cover}${property.cover.startsWith('/api/') ? '?w=900' : ''}`}
      alt={property.title}
      width="384"
      height="290"
      loading="lazy"
      decoding="async"
      class="size-full object-cover transition-transform duration-300 hover:scale-105"
    />
  </a>

  <div class="flex flex-col gap-3 p-6 text-fg">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="text-[20px] font-bold">
        <a href={href} class="transition-opacity hover:opacity-70">{property.title}</a>
      </h3>
      {property.zone && <span class="text-[12px] font-semibold whitespace-nowrap">{property.zone}</span>}
    </div>

    <p class="font-display text-[32px] font-bold text-accent">
      {formatPriceShort(property.price)}
    </p>

    {meta && <p class="text-[12px] font-semibold">{meta}</p>}
  </div>
</article>
